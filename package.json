{
  "name": "@ni-c/imap-mcp",
  "version": "0.2.0",
  "mcpName": "io.github.ni-c/imap-mcp",
  "description": "MCP server for IMAP mailboxes: read, search, organise and draft mail — it cannot send",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "imap",
    "email",
    "mail",
    "mailbox",
    "read-only"
  ],
  "license": "MIT",
  "author": "Willi Thiel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ni-c/imap-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ni-c/imap-mcp/issues"
  },
  "homepage": "https://imap-mcp.ni-c.de",
  "funding": "https://github.com/sponsors/ni-c",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "imap-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepublishOnly": "npm run lint && npm run build && npm test",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "oxlint --deny-warnings && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "assets": "node scripts/gen-assets.mjs",
    "assets:check": "node scripts/gen-assets.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "imapflow": "^1.7.6",
    "mailparser": "^3.9.17",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
